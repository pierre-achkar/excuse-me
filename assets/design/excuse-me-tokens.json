{
  "$description": "Excuse Me design tokens v1. Tokens Studio / Figma Variables compatible. Two-layer system: pixel (shop + cards) and ui (clean chrome).",
  "pixel": {
    "violet": { "$value": "#7F5BD6", "$type": "color", "$description": "Owner cloak and hood, card header" },
    "violet-dark": { "$value": "#6144B8", "$type": "color", "$description": "Shading on violet, hood interior" },
    "teal": { "$value": "#3FB6A0", "$type": "color", "$description": "Cloak trim, family tag" },
    "glow": { "$value": "#FCDE5A", "$type": "color", "$description": "Owner eyes, rarity stamp text, sparkles. Scarcest token." },
    "ember": { "$value": "#E8593C", "$type": "color", "$description": "Cigarette tip, pixel-layer warnings" },
    "outline": { "$value": "#1A1622", "$type": "color", "$description": "All sprite outlines, pixel text on light fills" }
  },
  "paper": {
    "body": { "$value": "#FAEEDA", "$type": "color", "$description": "Card body behind the claim" },
    "panel": { "$value": "#EDEAE2", "$type": "color", "$description": "Card art panel, sprite sheet background" },
    "divider": { "$value": "#DCD2B8", "$type": "color", "$description": "Card footer rule, 3px hard edge" },
    "meta": { "$value": "#8A7B5E", "$type": "color", "$description": "Collection number, small card labels" },
    "skin": { "$value": "#F0C08A", "$type": "color", "$description": "Sprite skin tone only, never a UI surface" }
  },
  "ui": {
    "canvas": { "$value": "#FBFAF7", "$type": "color" },
    "surface": { "$value": "#FFFFFF", "$type": "color" },
    "hairline": { "$value": "#E7E4DD", "$type": "color" },
    "text-primary": { "$value": "#241F2E", "$type": "color" },
    "text-secondary": { "$value": "#6B6558", "$type": "color" },
    "accent": { "$value": "#7F5BD6", "$type": "color", "$description": "Identical to pixel.violet. The only thread between layers." }
  },
  "ui-dark": {
    "canvas": { "$value": "#161320", "$type": "color" },
    "surface": { "$value": "#1F1B2A", "$type": "color" },
    "hairline": { "$value": "#2E2939", "$type": "color" },
    "text-primary": { "$value": "#F4F1F6", "$type": "color" },
    "text-secondary": { "$value": "#A09AAF", "$type": "color" },
    "accent": { "$value": "#7F5BD6", "$type": "color" }
  },
  "font": {
    "pixel": { "$value": "Press Start 2P", "$type": "fontFamily", "$description": "Pixel layer only. Max 11px, max 3 words." },
    "sans": { "$value": "Inter Tight", "$type": "fontFamily", "$description": "All real language, both layers." }
  },
  "type": {
    "card-name": { "$value": { "fontFamily": "{font.pixel}", "fontSize": "11px", "lineHeight": "1.5", "fontWeight": "400" }, "$type": "typography" },
    "rarity-stamp": { "$value": { "fontFamily": "{font.pixel}", "fontSize": "9px", "lineHeight": "1.4", "fontWeight": "400" }, "$type": "typography" },
    "tag": { "$value": { "fontFamily": "{font.pixel}", "fontSize": "8px", "lineHeight": "1.4", "fontWeight": "400" }, "$type": "typography" },
    "dialogue": { "$value": { "fontFamily": "{font.sans}", "fontSize": "19px", "lineHeight": "1.4", "fontWeight": "400" }, "$type": "typography" },
    "claim": { "$value": { "fontFamily": "{font.sans}", "fontSize": "17px", "lineHeight": "1.45", "fontWeight": "400" }, "$type": "typography" },
    "chip": { "$value": { "fontFamily": "{font.sans}", "fontSize": "14px", "lineHeight": "1.3", "fontWeight": "400" }, "$type": "typography" },
    "chrome-title": { "$value": { "fontFamily": "{font.sans}", "fontSize": "20px", "lineHeight": "1.3", "fontWeight": "500" }, "$type": "typography" },
    "chrome-body": { "$value": { "fontFamily": "{font.sans}", "fontSize": "16px", "lineHeight": "1.5", "fontWeight": "400" }, "$type": "typography" },
    "chrome-meta": { "$value": { "fontFamily": "{font.sans}", "fontSize": "12px", "lineHeight": "1.4", "fontWeight": "400" }, "$type": "typography" }
  },
  "space": {
    "1": { "$value": "4px", "$type": "spacing" },
    "2": { "$value": "8px", "$type": "spacing" },
    "3": { "$value": "12px", "$type": "spacing" },
    "4": { "$value": "16px", "$type": "spacing" },
    "6": { "$value": "24px", "$type": "spacing" },
    "8": { "$value": "32px", "$type": "spacing" },
    "12": { "$value": "48px", "$type": "spacing" }
  },
  "radius": {
    "pixel": { "$value": "4px", "$type": "borderRadius", "$description": "Maximum in the pixel layer" },
    "control": { "$value": "8px", "$type": "borderRadius" },
    "card": { "$value": "12px", "$type": "borderRadius" },
    "pill": { "$value": "999px", "$type": "borderRadius" }
  },
  "border": {
    "card-pixel": { "$value": "6px", "$type": "borderWidth", "$description": "Excuse card outer border" },
    "rule-pixel": { "$value": "3px", "$type": "borderWidth", "$description": "Card footer divider" },
    "hairline": { "$value": "1px", "$type": "borderWidth" }
  },
  "size": {
    "touch-min": { "$value": "44px", "$type": "sizing" },
    "chip-height": { "$value": "48px", "$type": "sizing" },
    "card-width": { "$value": "300px", "$type": "sizing" },
    "card-art-height": { "$value": "150px", "$type": "sizing" },
    "sprite-grid": { "$value": "26px", "$type": "sizing", "$description": "Owner sprite cell size. Scale by integers only." }
  },
  "duration": {
    "chip-press": { "$value": "120ms", "$type": "duration" },
    "dialogue-change": { "$value": "180ms", "$type": "duration" },
    "chrome": { "$value": "200ms", "$type": "duration" },
    "card-reveal": { "$value": "400ms", "$type": "duration", "$description": "Use steps(6) easing, not a smooth curve" },
    "glitch-burst": { "$value": "80ms", "$type": "duration" },
    "sprite-idle-frame": { "$value": "600ms", "$type": "duration" }
  },
  "enum": {
    "families": {
      "$value": "Capacity and wellbeing, Care and family, Work and study, Money and logistics, Planning failure, Boundary and preference, Absurd and dramatic",
      "$type": "other",
      "$description": "M1.2 excuse families. Function as card types."
    },
    "tones": {
      "$value": "Low-key, Nice, Funny, Dramatic, Unhinged",
      "$type": "other",
      "$description": "M1.2 tones. Chosen in dialogue beat 4, shown on card footer."
    },
    "rarity": {
      "$value": "common, uncommon, rare, legendary",
      "$type": "other",
      "$description": "Abstract and independent of tone. Collection mechanic only."
    }
  }
}
